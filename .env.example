# ClipperHelper Environment Configuration Example
# Copy to .env for local development. Never commit real credentials or secrets!

# Supabase (Public Client Configuration)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJh...placeholder_anon_key...

# YouTube Embed Bridge Origin
VITE_BRIDGE_URL=https://clipper-bridge.vercel.app

# Environment Mode
NODE_ENV=development
