{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for ClipperHelper desktop app",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        { "path": "$LOCALDATA/ClipperHelper/logs" },
        { "path": "$LOCALDATA/ClipperHelper-Dev/logs" }
      ]
    },
    "dialog:allow-open",
    "dialog:allow-save"
  ]
}
