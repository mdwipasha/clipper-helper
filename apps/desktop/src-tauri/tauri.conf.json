{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClipperHelper",
  "version": "0.1.0",
  "identifier": "com.clipperhelper.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://*.supabase.co https://*.r2.cloudflarestorage.com; frame-src https://clipper-bridge.vercel.app; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; font-src 'self' asset:",
      "capabilities": ["default"],
      "assetProtocol": {
        "enable": true,
        "scope": ["$LOCALAPPDATA/ClipperHelper/**", "$LOCALAPPDATA/ClipperHelper-Dev/**"]
      }
    },
    "windows": [
      {
        "title": "ClipperHelper",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
